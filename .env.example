# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local จะไม่ถูก commit ขึ้น Git)
# ค่าสองตัวนี้ออกแบบมาให้อยู่ฝั่งหน้าเว็บได้ (สิทธิ์ถูกคุมด้วย Row Level Security ของ Supabase)

# Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Publishable key (หรือ anon public key ถ้าเห็นแค่อันนั้น)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ห้ามใส่ GEMINI_API_KEY หรือ service_role key ในไฟล์นี้
# GEMINI_API_KEY ให้ใส่ใน Supabase > Edge Functions > Secrets เท่านั้น
